{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decant",
  "version": "2.0.0",
  "identifier": "io.github.dezdickey.decant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Decant",
        "width": 1100,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Move files to the cloud, prove every one arrived intact, then free the space.",
    "longDescription": "Decant uploads a folder to any cloud rclone supports, compares every file with its cloud copy by checksum, and only then offers to remove the local originals.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/decant-rclone"],
    "resources": {
      "../third-party/rclone-LICENSE.txt": "third-party/rclone-LICENSE.txt"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
